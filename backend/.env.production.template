# Production Environment Variables Template

# ==============================================
# CRITICAL: DO NOT COMMIT THIS FILE WITH REAL VALUES
# Copy this file to .env and fill in the values
# ==============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=5000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate a strong random secret key
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# Token expiration time
JWT_EXPIRE=7d

# ============================================
# FRONTEND URL (CORS)
# ============================================
# Your Vercel frontend URL (will be provided after Vercel deployment)
# Example: https://your-app-name.vercel.app
FRONTEND_URL=https://your-vercel-app-url.vercel.app

# ============================================
# EMAIL CONFIGURATION (Gmail)
# ============================================
# Gmail address to send emails from
EMAIL_USER=your.email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
# 1. Go to Google Account settings
# 2. Security → 2-Step Verification (enable if not enabled)
# 3. Security → App passwords
# 4. Create app password for "Mail"
# 5. Copy the 16-character password
EMAIL_PASS=your_16_character_app_password

# ============================================
# ADMIN ACCOUNT (for seeding)
# ============================================
# Default admin credentials (change after first login)
ADMIN_EMAIL=admin@felicity.com
ADMIN_PASSWORD=Admin@123456

# ============================================
# FILE UPLOAD
# ============================================
# Maximum file size in bytes (10MB)
MAX_FILE_SIZE=10485760

# ============================================
# DISCORD WEBHOOK (Optional - for notifications)
# ============================================
# If you want Discord notifications when events are published
# Leave empty to disable
DISCORD_WEBHOOK_URL=

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. MongoDB Atlas Setup:
#    - Create FREE M0 Sandbox cluster
#    - Create database user
#    - Whitelist IP: 0.0.0.0/0 (all IPs)
#    - Copy connection string
#
# 2. JWT Secret:
#    - Generate strong random string
#    - Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# 3. Email Configuration:
#    - Use Gmail App Password, NOT regular password
#    - Enable 2-Step Verification first
#
# 4. Frontend URL:
#    - Deploy frontend to Vercel first
#    - Copy the Vercel URL
#    - Add it here for CORS
#
# 5. Security:
#    - Never commit .env file to git
#    - Use different secrets for production vs development
#    - Rotate secrets regularly
